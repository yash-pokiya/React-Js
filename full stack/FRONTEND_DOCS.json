{
  "project": {
    "name": "crud-ecommerce",
    "description": "E-commerce backend using Express and raw MySQL2 queries",
    "baseUrl": "/",
    "authType": "JWT",
    "tokenStorage": "cookie"
  },
  "envKeys": [
    "PORT",
    "JWT_SECRET"
  ],
  "models": [
    {
      "name": "users",
      "fields": [
        { "name": "id", "type": "number", "required": true, "notes": "Primary Key" },
        { "name": "fullname", "type": "string", "required": true, "notes": "" },
        { "name": "username", "type": "string", "required": true, "notes": "" },
        { "name": "email", "type": "string", "required": true, "notes": "" },
        { "name": "password", "type": "string", "required": true, "notes": "Hashed string" },
        { "name": "address", "type": "string", "required": false, "notes": "" },
        { "name": "isAdmin", "type": "number", "required": false, "notes": "1 for admin" }
      ]
    },
    {
      "name": "products",
      "fields": [
        { "name": "id", "type": "number", "required": true, "notes": "Primary Key" },
        { "name": "product_name", "type": "string", "required": true, "notes": "" },
        { "name": "description", "type": "string", "required": true, "notes": "" },
        { "name": "price", "type": "number", "required": true, "notes": "" },
        { "name": "stock", "type": "number", "required": true, "notes": "" },
        { "name": "category_id", "type": "number", "required": false, "notes": "" },
        { "name": "category", "type": "string", "required": false, "notes": "" }
      ]
    },
    {
      "name": "orders",
      "fields": [
        { "name": "id", "type": "number", "required": true, "notes": "Primary Key" },
        { "name": "user_id", "type": "number", "required": true, "notes": "Foreign Key to users" },
        { "name": "product_id", "type": "number", "required": true, "notes": "Foreign Key to products" },
        { "name": "amount", "type": "number", "required": true, "notes": "Total amount" },
        { "name": "quantity", "type": "number", "required": true, "notes": "" },
        { "name": "status", "type": "string", "required": false, "notes": "" },
        { "name": "created_at", "type": "string", "required": false, "notes": "Date string" }
      ]
    },
    {
      "name": "categories",
      "fields": [
        { "name": "id", "type": "number", "required": true, "notes": "Primary Key" },
        { "name": "category_name", "type": "string", "required": true, "notes": "" },
        { "name": "description", "type": "string", "required": true, "notes": "" }
      ]
    },
    {
      "name": "addresses",
      "fields": [
        { "name": "id", "type": "number", "required": true, "notes": "Primary Key" },
        { "name": "user_id", "type": "number", "required": true, "notes": "Foreign Key to users" },
        { "name": "address", "type": "string", "required": true, "notes": "" },
        { "name": "city", "type": "string", "required": true, "notes": "" },
        { "name": "state", "type": "string", "required": false, "notes": "" },
        { "name": "pincode", "type": "string", "required": false, "notes": "" },
        { "name": "country", "type": "string", "required": false, "notes": "Defaults to India" }
      ]
    },
    {
      "name": "cart",
      "fields": [
        { "name": "user_id", "type": "number", "required": true, "notes": "Foreign Key to users" },
        { "name": "product_id", "type": "number", "required": true, "notes": "Foreign Key to products" },
        { "name": "quantity", "type": "number", "required": true, "notes": "Defaults to 1" }
      ]
    },
    {
      "name": "reviews",
      "fields": [
        { "name": "user_id", "type": "number", "required": true, "notes": "Foreign Key to users" },
        { "name": "product_id", "type": "number", "required": true, "notes": "Foreign Key to products" },
        { "name": "rating", "type": "number", "required": true, "notes": "Between 1 and 5" },
        { "name": "review", "type": "string", "required": false, "notes": "" },
        { "name": "created_at", "type": "string", "required": false, "notes": "Date string" }
      ]
    },
    {
      "name": "wishlists",
      "fields": [
        { "name": "user_id", "type": "number", "required": true, "notes": "Foreign Key to users" },
        { "name": "product_id", "type": "number", "required": true, "notes": "Foreign Key to products" },
        { "name": "created_at", "type": "string", "required": false, "notes": "Date string" }
      ]
    }
  ],
